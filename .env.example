# Candleway example environment file
# Copy to .env and fill values before running locally

# Google AI key (required for AI endpoints)
GOOGLE_API_KEY=

# Postgres / Supabase connection (used by server DB features)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Server and Vite ports
PORT=5000
VITE_PORT=5173
NODE_ENV=development

# Stripe (if using billing routes)
STRIPE_SECRET_KEY=

# Supabase (if used)
# Vite expects `VITE_*` keys for client-side access
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Optional: email provider, Sentry, etc.
SMTP_URL=
EMAIL_FROM=
SENTRY_DSN=
# Server-side values. Never commit the real values.
DATABASE_URL=
GOOGLE_API_KEY=
# (server-side) Supabase admin URL / secret - do NOT expose in client
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# Optional features
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
SENDGRID_API_KEY=
FROM_EMAIL=noreply@example.com
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
# Required to encrypt saved MT5 passwords. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MT5_CREDENTIALS_ENCRYPTION_KEY=
# Optional: full path to the Python executable with requirements-mt5.txt installed
MT5_PYTHON_PATH=