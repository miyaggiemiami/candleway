# Point this at the separately deployed Flask API. Use HTTPS outside local dev.
TRADING_QUEUE_URL=https://your-queue-service.example
# Paste the one-time key printed by provision_license.py here; never commit .env.
TRADING_QUEUE_LICENSE_KEY=replace-with-issued-license-key

# Use a MetaTrader 5 demo account first. Real-account trading is blocked by default.
MT5_ALLOW_LIVE_TRADING=false
MT5_MAGIC=234000
MT5_DEVIATION_POINTS=20
POLL_SECONDS=2
MONITOR_SECONDS=5
LOG_LEVEL=INFO

# Optional comma-separated overrides for brokers with nonstandard pip definitions:
# MT5_PIP_SIZE_OVERRIDES=XAUUSD:0.10,US30:1.0
MT5_PIP_SIZE_OVERRIDES=