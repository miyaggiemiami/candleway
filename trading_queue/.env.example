# Use the shared PostgreSQL DATABASE_URL in Replit, or set this service-specific
# override. Never put a production connection string in this example file.
TRADING_QUEUE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
APP_ENV=production
PORT=8000
QUEUE_CLAIM_LEASE_SECONDS=180
QUEUE_MAX_CLAIM_ATTEMPTS=5
QUEUE_MAX_TRADE_VOLUME=1.00
TRADING_QUEUE_ALLOWED_ORIGINS=https://your-apexium-app.example

# Local development only: opt in to SQLite metadata creation for this service.
# Keep this false/unset in production; apply schema.sql through your migration flow.
TRADING_QUEUE_AUTO_CREATE_SCHEMA=false